# Stripe — full setup: docs/PAYMENTS.md | verify: npm run payments:verify

# Secret key (Dashboard → Developers → API keys). Test locally, live in production.

STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret. Local: npm run stripe:listen → copy whsec_...
# Production: Webhook endpoint /api/stripe/webhook, event checkout.session.completed

STRIPE_WEBHOOK_SECRET=whsec_...



# Signs registration cookies (use a long random string in production)

REGISTRATION_SECRET=change-me-to-a-long-random-string



# Admin dashboard (/admin) — required for staff access

ADMIN_PASSWORD=change-me-to-a-strong-password

ADMIN_SECRET=change-me-to-a-long-random-string



# Mobile app user registry (Iron Lion Shop app — mbs-healing API)

# Same STAFF_ADMIN_KEY value as in the mbs-healing api/.env

MBS_HEALING_API_URL=http://localhost:3001

MBS_HEALING_STAFF_KEY=change-me-to-match-staff-admin-key



# PostgreSQL for production (required on Vercel). Local dev can omit this (uses data/iron-lion.db).

# Neon: use the *pooled* connection string (host contains -pooler) for serverless/Vercel.

# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require



# Optional: POST each registration to Zapier, Make, HubSpot, etc.

# REGISTER_WEBHOOK_URL=https://hooks.example.com/...



# Optional: per-practitioner Calendly URLs (override content/site.ts defaults)

# CALENDLY_URL_JOHARI_TEMPLIN_JR=https://calendly.com/your-account/johari

# CALENDLY_URL_JOHNNY_LONA=https://calendly.com/your-account/johnny
# CALENDLY_URL_PIERRE_MIDDLETON=https://calendly.com/your-account/pierre
# CALENDLY_URL_DUAL_SESSION=https://calendly.com/your-account/dual-session



# Email via Resend (https://resend.com) — full setup: docs/EMAIL-SETUP.md
# Powers admin alerts AND customer confirmation emails (bookings, shop orders, retreat payments).
# Without RESEND_API_KEY, production sends nothing; local dev prints emails to the console.

# RESEND_API_KEY=re_...

# REQUIRED for customer email. Must use a domain verified in Resend.
# If unset, mail falls back to Resend's sandbox sender, which ONLY delivers to the Resend
# account owner — customers silently receive nothing. See docs/EMAIL-SETUP.md step 2.
# RESEND_FROM=Iron Lion <hello@ironlionfitnessandhealing.com>

# Where admin alerts go, and the reply-to address on customer email.
# ADMIN_NOTIFY_EMAIL=ironlionhealing@gmail.com



# Optional: AI-assisted wellness guide

# OPENAI_API_KEY=sk-...

# OPENAI_MODEL=gpt-4o-mini

